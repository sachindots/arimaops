{
  "name": "arimaops",
  "version": "0.8.0",
  "description": "Lead the pride: your AI company in one office. AI agents build your software and run your security work while you steer from desk, tablet or phone.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "homepage": "https://github.com/sachindots/arimaops#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sachindots/arimaops.git"
  },
  "bugs": {
    "url": "https://github.com/sachindots/arimaops/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "coding-agents",
    "antigravity",
    "claude",
    "claude-code",
    "codex",
    "opencode",
    "docker-sandboxes",
    "mcp",
    "developer-tools",
    "security-operations",
    "red-team",
    "pixel-art"
  ],
  "bin": {
    "arimaops": "bin/arimaops.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "dist-server",
    "scripts/fix-node-pty.mjs",
    "LICENSE",
    "LICENSES",
    "TRADEMARKS.md",
    "README.md",
    "NOTICE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:hq": "concurrently -k -n hq,ui -c magenta,cyan \"tsx watch server/main.ts --dev\" \"vite\"",
    "hq": "vite build --logLevel warn && tsx server/main.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "build": "tsc --noEmit -p . && tsc --noEmit -p server && vite build && node scripts/build-server.mjs",
    "test": "node scripts/run-tests.mjs",
    "bench": "node --import tsx scripts/bench/run.ts",
    "preview": "vite preview",
    "prepack": "npm run build",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/headless": "5.5.0",
    "ae-cvss-calculator": "1.0.13",
    "neo4j-driver": "6.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "framer-motion": "^11.18.2",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "zustand": "^5.0.15"
  }
}
