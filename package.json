{
  "name": "arimaops",
  "version": "2.0.0",
  "private": true,
  "description": "Lead the pride: your AI company in one office. AI agents build your software and run your security work while you steer from desk, tablet or phone.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "homepage": "https://github.com/sachindots/arimaops#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sachindots/arimaops.git"
  },
  "bugs": {
    "url": "https://github.com/sachindots/arimaops/issues"
  },
  "scripts": {
    "dev": "sh -c 'HQ_PORT=7430 cargo run --manifest-path server-rs/Cargo.toml --bin arima-server & P=$!; trap \"kill $P 2>/dev/null\" EXIT INT TERM; HQ_PORT=7430 vite'",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && vite build",
    "gen:team": "tsx scripts/export-team-data.ts",
    "gen:types": "cargo run --quiet --manifest-path server-rs/Cargo.toml -p arima-core --bin export_types -- src/data/generated.ts",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@material-symbols/font-400": "^0.49.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
