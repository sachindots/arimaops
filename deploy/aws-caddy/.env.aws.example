# ArimaOps v2.0 — AWS EC2 + Caddy Production Environment Template
# Copy to .env with `chmod 600 .env` and fill in your real values.

# Apex domain controlled in Route53, Cloudflare, or your DNS provider.
# Create A/AAAA records pointing to your EC2 Elastic IP for:
#   - hq.<ARIMA_DOMAIN>
#   - *.<ARIMA_DOMAIN>   (or preview-*.<ARIMA_DOMAIN>)
ARIMA_DOMAIN=example.com

# Contact email for Let's Encrypt automatic TLS certificates.
ACME_EMAIL=ops@example.com

# Container images (override if building locally or using a custom Caddy DNS plugin build).
ARIMA_HQ_IMAGE=ghcr.io/sachindots/arimaops-v2:latest
CADDY_IMAGE=caddy:2.9-alpine

# Host directory holding checked-out project workspaces.
ARIMA_WORKSPACES_DIR=/opt/arimaops/workspaces

# Random secret for verifying GitHub App / repository X-Hub-Signature-256 webhooks.
# Generate with: openssl rand -hex 32
ARIMA_GITHUB_WEBHOOK_SECRET=replace-with-32-byte-random-hex

# Optional: only required if switching Caddyfile from on-demand TLS to DNS-01 wildcard certs.
CLOUDFLARE_API_TOKEN=
AWS_REGION=us-east-1

# Log verbosity for arima-server.
RUST_LOG=info
