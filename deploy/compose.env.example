# Copy to .env next to compose.yaml and fill in values for your host.
# Find your Docker socket group id:
#   Linux: stat -c %g /var/run/docker.sock
#   macOS: stat -f %g /var/run/docker.sock
DOCKER_GID=999

# 32-byte hex master key for the HQ credentials vault (`openssl rand -hex 32`).
ARIMA_MASTER_KEY=replace-with-32-byte-random-hex

# Host directory mounted at /workspaces and shared with agent containers.
ARIMA_WORKSPACES_DIR=./workspaces

# Published container images (or leave default).
ARIMA_HQ_IMAGE=ghcr.io/sachindots/arimaops-v2:latest
ARIMA_AGENT_IMAGE=ghcr.io/sachindots/arimaops-agent:latest

# Loopback ports on the host.
HQ_HOST_PORT=7420
HQ_PREVIEW_HOST_PORT=7421
RUST_LOG=info
