# Copy to .env next to compose.yaml. Fill these from the server user that owns ArimaOps:
#   id -u ; id -g ; getent group docker | cut -d: -f3 ; echo $HOME
ARIMA_UID=1000
ARIMA_GID=1000
DOCKER_GID=999
ARIMA_HOME_DIR=/home/arima
# The git repo HQ opens first (any repo; more projects are added from the UI).
ARIMA_REPO=/home/arima/projects/hq-home
ARIMA_PORT=7420
# Unlocks the credentials vault. Generate once and keep it safe: openssl rand -hex 32
ARIMA_MASTER_KEY=
# Optional: a published image instead of building from this checkout.
# ARIMA_IMAGE=arimaops:latest
