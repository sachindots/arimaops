{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for the ArimaOps unified multi-server client (local picker + connected HQ origins).",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default"
  ]
}
