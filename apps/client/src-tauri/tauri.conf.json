{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArimaOps",
  "version": "2.0.0-alpha.0",
  "identifier": "tech.arimaops.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArimaOps",
        "width": 1360,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#060a14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
