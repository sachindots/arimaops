  "name": "get_job_logs",
  "description": "Download logs for a CI job, or all failed jobs in a run, returning the tail of each log.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "owner": {
     "type": "string",
     "description": "Repository owner (user or organisation)."
    },
    "repo": {
     "type": "string",
     "description": "Repository name."
    },
    "job_id": {
     "type": "integer",
     "description": "The unique identifier of the job (needed for single-job logs)."
    },
    "run_id": {
     "type": "integer",
     "description": "Workflow run ID (needed when failed_only is true)."
    },
    "failed_only": {
     "type": "boolean",
     "description": "When true, gets logs for every failed job in run_id."
    },
    "return_content": {
     "type": "boolean",
     "description": "Returns the log content instead of URLs."
    },
    "tail_lines": {
     "type": "integer",
     "description": "Number of lines to return from the end of the log.",
     "default": 500
    }
   },
   "required": [
    "owner",
    "repo"
   ]
  },
